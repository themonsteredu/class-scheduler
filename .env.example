NEXT_PUBLIC_SUPABASE_URL=https://awjndrxyyqyngybulyor.supabase.co
# monster-moakit 프로젝트의 공개 publishable 키. 변수명은 기존 배포와 호환되게 유지합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 회원 관리는 로그인한 관리자 권한의 RPC로 처리하므로 service_role 키는 사용하지 않습니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 웹 푸시(교구 부족 알림). 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
